ocio_profile_version: 2.5

environment:
  {}
search_path: luts
strictparsing: true
luma: [0.2126, 0.7152, 0.0722]
name: photosite_v0.01.02-ocio_v2.5
description: |
  Photosite v0.01.02 (OCIO 2.5): photographic views that preview scene-linear CGI as an unedited photograph from a
  single-ISO CMOS mirrorless camera. Scene-linear workflow: ACES2065-1 reference, ACEScg working space (linear AP0,
  Rec.709, Rec.2020, P3-D65, AdobeRGB and CIE XYZ-D65 inputs are also provided). Scene 0.18 is the camera's metered
  middle grey; the sensor's green channel clips 3.70 stops above it.
    JPG <profile>  the camera's picture profile (no adjustments, D65 white balance) on a 65^3 camera-RGB lattice, with the
                   in-camera JPEG's own tone curve for a neutral at every exposure, measured on the camera: 0.18 renders as
                   the camera's middle grey, white is reached by the sensor's green clip, black is below half an 8-bit code.
                   The sRGB and Rec.1886 displays show the camera's sRGB-mode JPEG and every other display its Adobe RGB-mode
                   JPEG (the camera writes the same tone codes in both), under the same view names.
    Sensor RAW     scene-linear sensor data clipped at the sensor's per-channel clipping points. No tone curve: an
                   inspection view.
  "<display> (gamut compressed)" displays compress out-of-gamut colours instead of clipping them.
  The stock ACES 2.0 views, displays and colour spaces are kept. Released by release_photosite_v0.01.02.py.

roles:
  aces_interchange: ACES2065-1
  cie_xyz_d65_interchange: CIE XYZ-D65 - Display-referred
  color_picking: sRGB Encoded Rec.709 (sRGB)
  color_timing: ACEScct
  compositing_linear: ACEScg
  compositing_log: ACEScct
  data: Raw
  default_byte: sRGB Encoded Rec.709 (sRGB)
  default_float: ACEScg
  default_sequencer: sRGB Encoded Rec.709 (sRGB)
  matte_paint: ACEScct
  reference: ACES2065-1
  rendering: ACEScg
  scene_linear: ACEScg
  srgb_linear: Linear Rec.709 (sRGB)
  texture_paint: sRGB Encoded Rec.709 (sRGB)
  # Substance Painter bitmap conventions, mapped to this config's ACES workflow.
  substance_3d_painter_standard_srgb: sRGB Encoded Rec.709 (sRGB)
  substance_3d_painter_bitmap_import_8bit: sRGB Encoded Rec.709 (sRGB)
  substance_3d_painter_bitmap_import_16bit: sRGB Encoded Rec.709 (sRGB)
  substance_3d_painter_bitmap_import_floating: ACEScg
  substance_3d_painter_bitmap_export_8bit: sRGB Encoded Rec.709 (sRGB)
  substance_3d_painter_bitmap_export_16bit: sRGB Encoded Rec.709 (sRGB)
  substance_3d_painter_bitmap_export_floating: ACEScg
  substance_3d_painter_substance_material: sRGB Encoded Rec.709 (sRGB)

file_rules:
  # Tokenized workflow (generated by build_photosite_v0.0.3.py, released as v0.01.02). First match wins:
  # 1 token right before the extension (Arnold tx naming: wood_srgb_texture_ACEScg.tx is ACEScg)
  - !<Rule> {name: tokenized_Raw_suffix, colorspace: Raw, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([rR][aA][wW]|[dD][aA][tT][aA]|[nN][oO][nN]_?[cC][oO][lL][oO][uU]?[rR]|[uU][tT][iI][lL][iI][tT][yY]_[rR][aA][wW])\\.[^/\\\\.]+\\]?"}
  - !<Rule> {name: tokenized_ACES2065_1_suffix, colorspace: ACES2065-1, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([aA][cC][eE][sS]2065[_-]1|[lL][iI][nN]_[aA][pP]0(_[sS][cC][eE][nN][eE])?|[aA][pP]0)\\.[^/\\\\.]+\\]?"}
  - !<Rule> {name: tokenized_ACEScg_suffix, colorspace: ACEScg, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([aA][cC][eE][sS][cC][gG]|[lL][iI][nN]_[aA][cC][eE][sS][cC][gG]|[lL][iI][nN]_[aA][pP]1(_[sS][cC][eE][nN][eE])?)\\.[^/\\\\.]+\\]?"}
  - !<Rule> {name: tokenized_ACEScct_suffix, colorspace: ACEScct, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([aA][cC][eE][sS][cC][cC][tT](_[aA][pP]1)?)\\.[^/\\\\.]+\\]?"}
  - !<Rule> {name: tokenized_ACEScc_suffix, colorspace: ACEScc, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([aA][cC][eE][sS][cC][cC](_[aA][pP]1)?)\\.[^/\\\\.]+\\]?"}
  - !<Rule> {name: tokenized_LinRec709_suffix, colorspace: Linear Rec.709 (sRGB), regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([lL][iI][nN]([eE][aA][rR])?_?([rR][eE][cC]\\.?|[bB][tT])709(_[sS][rR][gG][bB]|_[sS][cC][eE][nN][eE])?|[lL][iI][nN]([eE][aA][rR])?_?[sS][rR][gG][bB])\\.[^/\\\\.]+\\]?"}
  - !<Rule> {name: tokenized_LinRec2020_suffix, colorspace: Linear Rec.2020, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([lL][iI][nN]([eE][aA][rR])?_?([rR][eE][cC]\\.?|[bB][tT])2020(_[sS][cC][eE][nN][eE])?)\\.[^/\\\\.]+\\]?"}
  - !<Rule> {name: tokenized_LinP3D65_suffix, colorspace: Linear P3-D65, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([lL][iI][nN]([eE][aA][rR])?_?([pP]3_?[dD]65|[dD][iI][sS][pP][lL][aA][yY]_?[pP]3)(_[sS][cC][eE][nN][eE])?)\\.[^/\\\\.]+\\]?"}
  - !<Rule> {name: tokenized_LinAdobeRGB_suffix, colorspace: Linear AdobeRGB, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([lL][iI][nN]([eE][aA][rR])?_?[aA][dD][oO][bB][eE]_?[rR][gG][bB](_[sS][cC][eE][nN][eE])?)\\.[^/\\\\.]+\\]?"}
  - !<Rule> {name: tokenized_CIEXYZD65_suffix, colorspace: CIE XYZ-D65 - Scene-referred, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?(([lL][iI][nN]_)?[cC][iI][eE]_?[xX][yY][zZ]_?[dD]65(_[sS][cC][eE][nN][eE])?)\\.[^/\\\\.]+\\]?"}
  - !<Rule> {name: tokenized_sRGB_P3D65_suffix, colorspace: sRGB Encoded P3-D65, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([sS][rR][gG][bB]_([eE][nN][cC][oO][dD][eE][dD]_)?([pP]3_?[dD]65|[dD][iI][sS][pP][lL][aA][yY]_?[pP]3)(_[sS][cC][eE][nN][eE]|_[tT][xX])?)\\.[^/\\\\.]+\\]?"}
  - !<Rule> {name: tokenized_sRGB_AP1_suffix, colorspace: sRGB Encoded AP1, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([sS][rR][gG][bB]_([eE][nN][cC][oO][dD][eE][dD]_)?[aA][pP]1(_[sS][cC][eE][nN][eE]|_[tT][xX])?)\\.[^/\\\\.]+\\]?"}
  - !<Rule> {name: tokenized_G22_AP1_suffix, colorspace: Gamma 2.2 Encoded AP1, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([gG]22_([eE][nN][cC][oO][dD][eE][dD]_)?[aA][pP]1(_[sS][cC][eE][nN][eE]|_[tT][xX])?)\\.[^/\\\\.]+\\]?"}
  - !<Rule> {name: tokenized_G18_Rec709_suffix, colorspace: Gamma 1.8 Encoded Rec.709, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([gG]18_([eE][nN][cC][oO][dD][eE][dD]_)?[rR][eE][cC]\\.?709(_[sS][cC][eE][nN][eE]|_[tT][xX])?)\\.[^/\\\\.]+\\]?"}
  - !<Rule> {name: tokenized_G22_Rec709_suffix, colorspace: Gamma 2.2 Encoded Rec.709, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([gG]22_([eE][nN][cC][oO][dD][eE][dD]_)?[rR][eE][cC]\\.?709(_[sS][cC][eE][nN][eE]|_[tT][xX])?)\\.[^/\\\\.]+\\]?"}
  - !<Rule> {name: tokenized_G24_Rec709_suffix, colorspace: Gamma 2.4 Encoded Rec.709, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([gG]24_([eE][nN][cC][oO][dD][eE][dD]_)?[rR][eE][cC]\\.?709(_[sS][cC][eE][nN][eE]|_[tT][xX])?|([rR][eE][cC]|[bB][tT])\\.?1886(_[rR][eE][cC]\\.?709)?|[rR][eE][cC]709_[dD][iI][sS][pP][lL][aA][yY])\\.[^/\\\\.]+\\]?"}
  - !<Rule> {name: tokenized_G22_AdobeRGB_suffix, colorspace: Gamma 2.2 Encoded AdobeRGB, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?(([gG]22_([eE][nN][cC][oO][dD][eE][dD]_)?)?[aA][dD][oO][bB][eE]_?[rR][gG][bB](_[sS][cC][eE][nN][eE])?)\\.[^/\\\\.]+\\]?"}
  - !<Rule> {name: tokenized_sRGB_suffix, colorspace: sRGB Encoded Rec.709 (sRGB), regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([sS][rR][gG][bB](_[eE][nN][cC][oO][dD][eE][dD])?(_[rR][eE][cC]\\.?709)?(_[sS][rR][gG][bB]|_[sS][cC][eE][nN][eE]|_[tT][xX]|_[tT][eE][xX][tT][uU][rR][eE])?)\\.[^/\\\\.]+\\]?"}
  # 2 token anywhere in the file name
  - !<Rule> {name: tokenized_Raw, colorspace: Raw, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([rR][aA][wW]|[dD][aA][tT][aA]|[nN][oO][nN]_?[cC][oO][lL][oO][uU]?[rR]|[uU][tT][iI][lL][iI][tT][yY]_[rR][aA][wW])[_.-][^/\\\\]*"}
  - !<Rule> {name: tokenized_ACES2065_1, colorspace: ACES2065-1, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([aA][cC][eE][sS]2065[_-]1|[lL][iI][nN]_[aA][pP]0(_[sS][cC][eE][nN][eE])?|[aA][pP]0)[_.-][^/\\\\]*"}
  - !<Rule> {name: tokenized_ACEScg, colorspace: ACEScg, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([aA][cC][eE][sS][cC][gG]|[lL][iI][nN]_[aA][cC][eE][sS][cC][gG]|[lL][iI][nN]_[aA][pP]1(_[sS][cC][eE][nN][eE])?)[_.-][^/\\\\]*"}
  - !<Rule> {name: tokenized_ACEScct, colorspace: ACEScct, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([aA][cC][eE][sS][cC][cC][tT](_[aA][pP]1)?)[_.-][^/\\\\]*"}
  - !<Rule> {name: tokenized_ACEScc, colorspace: ACEScc, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([aA][cC][eE][sS][cC][cC](_[aA][pP]1)?)[_.-][^/\\\\]*"}
  - !<Rule> {name: tokenized_LinRec709, colorspace: Linear Rec.709 (sRGB), regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([lL][iI][nN]([eE][aA][rR])?_?([rR][eE][cC]\\.?|[bB][tT])709(_[sS][rR][gG][bB]|_[sS][cC][eE][nN][eE])?|[lL][iI][nN]([eE][aA][rR])?_?[sS][rR][gG][bB])[_.-][^/\\\\]*"}
  - !<Rule> {name: tokenized_LinRec2020, colorspace: Linear Rec.2020, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([lL][iI][nN]([eE][aA][rR])?_?([rR][eE][cC]\\.?|[bB][tT])2020(_[sS][cC][eE][nN][eE])?)[_.-][^/\\\\]*"}
  - !<Rule> {name: tokenized_LinP3D65, colorspace: Linear P3-D65, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([lL][iI][nN]([eE][aA][rR])?_?([pP]3_?[dD]65|[dD][iI][sS][pP][lL][aA][yY]_?[pP]3)(_[sS][cC][eE][nN][eE])?)[_.-][^/\\\\]*"}
  - !<Rule> {name: tokenized_LinAdobeRGB, colorspace: Linear AdobeRGB, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([lL][iI][nN]([eE][aA][rR])?_?[aA][dD][oO][bB][eE]_?[rR][gG][bB](_[sS][cC][eE][nN][eE])?)[_.-][^/\\\\]*"}
  - !<Rule> {name: tokenized_CIEXYZD65, colorspace: CIE XYZ-D65 - Scene-referred, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?(([lL][iI][nN]_)?[cC][iI][eE]_?[xX][yY][zZ]_?[dD]65(_[sS][cC][eE][nN][eE])?)[_.-][^/\\\\]*"}
  - !<Rule> {name: tokenized_sRGB_P3D65, colorspace: sRGB Encoded P3-D65, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([sS][rR][gG][bB]_([eE][nN][cC][oO][dD][eE][dD]_)?([pP]3_?[dD]65|[dD][iI][sS][pP][lL][aA][yY]_?[pP]3)(_[sS][cC][eE][nN][eE]|_[tT][xX])?)[_.-][^/\\\\]*"}
  - !<Rule> {name: tokenized_sRGB_AP1, colorspace: sRGB Encoded AP1, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([sS][rR][gG][bB]_([eE][nN][cC][oO][dD][eE][dD]_)?[aA][pP]1(_[sS][cC][eE][nN][eE]|_[tT][xX])?)[_.-][^/\\\\]*"}
  - !<Rule> {name: tokenized_G22_AP1, colorspace: Gamma 2.2 Encoded AP1, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([gG]22_([eE][nN][cC][oO][dD][eE][dD]_)?[aA][pP]1(_[sS][cC][eE][nN][eE]|_[tT][xX])?)[_.-][^/\\\\]*"}
  - !<Rule> {name: tokenized_G18_Rec709, colorspace: Gamma 1.8 Encoded Rec.709, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([gG]18_([eE][nN][cC][oO][dD][eE][dD]_)?[rR][eE][cC]\\.?709(_[sS][cC][eE][nN][eE]|_[tT][xX])?)[_.-][^/\\\\]*"}
  - !<Rule> {name: tokenized_G22_Rec709, colorspace: Gamma 2.2 Encoded Rec.709, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([gG]22_([eE][nN][cC][oO][dD][eE][dD]_)?[rR][eE][cC]\\.?709(_[sS][cC][eE][nN][eE]|_[tT][xX])?)[_.-][^/\\\\]*"}
  - !<Rule> {name: tokenized_G24_Rec709, colorspace: Gamma 2.4 Encoded Rec.709, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([gG]24_([eE][nN][cC][oO][dD][eE][dD]_)?[rR][eE][cC]\\.?709(_[sS][cC][eE][nN][eE]|_[tT][xX])?|([rR][eE][cC]|[bB][tT])\\.?1886(_[rR][eE][cC]\\.?709)?|[rR][eE][cC]709_[dD][iI][sS][pP][lL][aA][yY])[_.-][^/\\\\]*"}
  - !<Rule> {name: tokenized_G22_AdobeRGB, colorspace: Gamma 2.2 Encoded AdobeRGB, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?(([gG]22_([eE][nN][cC][oO][dD][eE][dD]_)?)?[aA][dD][oO][bB][eE]_?[rR][gG][bB](_[sS][cC][eE][nN][eE])?)[_.-][^/\\\\]*"}
  - !<Rule> {name: tokenized_sRGB, colorspace: sRGB Encoded Rec.709 (sRGB), regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([sS][rR][gG][bB](_[eE][nN][cC][oO][dD][eE][dD])?(_[rR][eE][cC]\\.?709)?(_[sS][rR][gG][bB]|_[sS][cC][eE][nN][eE]|_[tT][xX]|_[tT][eE][xX][tT][uU][rR][eE])?)[_.-][^/\\\\]*"}
  # 3 untokenized PBR data maps and scalar controls
  - !<Rule> {name: tokenized_data_maps, colorspace: Raw, regex: "(.*[/\\\\])?([^/\\\\]*[_.-])?([nN][oO][rR][mM][aA][lL]|[nN][oO][rR][mM][aA][lL][sS]|[nN][oO][rR][mM][aA][lL]_?[gG][lL]|[nN][oO][rR][mM][aA][lL]_?[dD][xX]|[nN][oO][rR][mM][aA][lL]_?[oO][pP][eE][nN][gG][lL]|[nN][oO][rR][mM][aA][lL]_?[dD][iI][rR][eE][cC][tT][xX]|[nN][rR][mM]|[nN][oO][rR]|[nN][oO][rR][mM]|[nN][mM]|[cC][oO][aA][tT]_?[nN][oO][rR][mM][aA][lL]|[tT][aA][nN][gG][eE][nN][tT]|[cC][oO][aA][tT]_?[tT][aA][nN][gG][eE][nN][tT]|[bB][uU][mM][pP]|[hH][eE][iI][gG][hH][tT]|[hH][mM]|[dD][iI][sS][pP][lL][aA][cC][eE][mM][eE][nN][tT]|[dD][iI][sS][pP]|[dD][mM]|[rR][oO][uU][gG][hH][nN][eE][sS][sS]|[rR][oO][uU][gG][hH]|[rR][mM]|[sS][pP][eE][cC][uU][lL][aA][rR]_?[rR][oO][uU][gG][hH][nN][eE][sS][sS]|[gG][lL][oO][sS][sS][iI][nN][eE][sS][sS]|[gG][lL][oO][sS][sS]|[gG][mM]|[mM][eE][tT][aA][lL][lL][iI][cC]|[mM][eE][tT][aA][lL][nN][eE][sS][sS]|[mM][eE][tT][aA][lL]|[mM][mM]|[aA][mM][bB][iI][eE][nN][tT]_?[oO][cC][cC][lL][uU][sS][iI][oO][nN]|[oO][cC][cC][lL][uU][sS][iI][oO][nN]|[oO][cC][cC]|[aA][oO]|[oO][mM]|[cC][aA][vV][iI][tT][yY]|[cC][mM]|[cC][uU][rR][vV][aA][tT][uU][rR][eE]|[cC][uU][rR][vV]|[tT][hH][iI][cC][kK][nN][eE][sS][sS]|[tT][hH][iI][cC][kK]|[aA][nN][iI][sS][oO][tT][rR][oO][pP][yY]|[aA][nN][iI][sS][oO]|[aA][nN][iI][sS][oO][tT][rR][oO][pP][yY]_?[lL][eE][vV][eE][lL]|[aA][nN][iI][sS][oO]_?[lL][eE][vV][eE][lL]|[aA][nN][iI][sS][oO][tT][rR][oO][pP][yY]_?[aA][nN][gG][lL][eE]|[aA][nN][iI][sS][oO]_?[aA][nN][gG][lL][eE]|[aA][nN][iI][sS][oO][tT][rR][oO][pP][yY]_?[rR][oO][tT][aA][tT][iI][oO][nN]|[mM][aA][sS][kK]|[iI][dD]|[mM][aA][tT]_?[iI][dD]|[oO][pP][aA][cC][iI][tT][yY]|[aA][lL][pP][hH][aA]|[cC][uU][tT][oO][uU][tT]|[aA][rR][mM]|[oO][rR][mM]|[rR][mM][aA]|[mM][rR][aA]|[bB][aA][sS][eE]_?[wW][eE][iI][gG][hH][tT]|[sS][pP][eE][cC][uU][lL][aA][rR]_?[wW][eE][iI][gG][hH][tT]|[sS][pP][eE][cC][uU][lL][aA][rR]_?[lL][eE][vV][eE][lL]|[sS][pP][eE][cC][uU][lL][aA][rR]_?[aA][mM][oO][uU][nN][tT]|[sS][pP][eE][cC][uU][lL][aA][rR]_?[aA][nN][iI][sS][oO][tT][rR][oO][pP][yY]|[sS][pP][eE][cC][uU][lL][aA][rR]_?[aA][nN][iI][sS][oO][tT][rR][oO][pP][yY]_?[aA][nN][gG][lL][eE]|[cC][oO][aA][tT]_?[wW][eE][iI][gG][hH][tT]|[cC][oO][aA][tT]_?[rR][oO][uU][gG][hH][nN][eE][sS][sS]|[cC][oO][aA][tT]_?[rR][oO][uU][gG][hH][nN][eE][sS][sS]_?[aA][nN][iI][sS][oO][tT][rR][oO][pP][yY]|[cC][oO][aA][tT]_?[aA][nN][iI][sS][oO][tT][rR][oO][pP][yY]_?[aA][nN][gG][lL][eE]|[cC][oO][aA][tT]_?[dD][aA][rR][kK][eE][nN][iI][nN][gG]|[cC][oO][aA][tT]_?[mM][aA][sS][kK]|[tT][rR][aA][nN][sS][mM][iI][sS][sS][iI][oO][nN]_?[wW][eE][iI][gG][hH][tT]|[tT][rR][aA][nN][sS][mM][iI][sS][sS][iI][oO][nN]_?[dD][eE][pP][tT][hH]|[tT][rR][aA][nN][sS][mM][iI][sS][sS][iI][oO][nN]_?[sS][cC][aA][tT][tT][eE][rR]_?[aA][nN][iI][sS][oO][tT][rR][oO][pP][yY]|[tT][rR][aA][nN][sS][mM][iI][sS][sS][iI][oO][nN]_?[dD][iI][sS][pP][eE][rR][sS][iI][oO][nN]_?[sS][cC][aA][lL][eE]|[tT][rR][aA][nN][sS][mM][iI][sS][sS][iI][oO][nN]_?[dD][iI][sS][pP][eE][rR][sS][iI][oO][nN]_?[aA][bB][bB][eE]_?[nN][uU][mM][bB][eE][rR]|[tT][rR][aA][nN][sS][mM][iI][sS][sS][iI][oO][nN]_?[mM][aA][sS][kK]|[tT][rR][aA][nN][sS][lL][uU][cC][eE][nN][cC][yY]|[tT][rR][aA][nN][sS][lL][uU][cC][eE][nN][cC][yY]_?[wW][eE][iI][gG][hH][tT]|[tT][rR][aA][nN][sS][lL][uU][cC][eE][nN][cC][yY]_?[mM][aA][sS][kK]|[sS][uU][bB][sS][uU][rR][fF][aA][cC][eE]_?[wW][eE][iI][gG][hH][tT]|[sS][uU][bB][sS][uU][rR][fF][aA][cC][eE]_?[rR][aA][dD][iI][uU][sS]|[sS][uU][bB][sS][uU][rR][fF][aA][cC][eE]_?[rR][aA][dD][iI][uU][sS]_?[sS][cC][aA][lL][eE]|[sS][uU][bB][sS][uU][rR][fF][aA][cC][eE]_?[sS][cC][aA][tT][tT][eE][rR]_?[aA][nN][iI][sS][oO][tT][rR][oO][pP][yY]|[sS][uU][bB][sS][uU][rR][fF][aA][cC][eE]_?[mM][aA][sS][kK]|[sS][sS][sS]_?[wW][eE][iI][gG][hH][tT]|[sS][sS][sS]_?[mM][aA][sS][kK]|[fF][uU][zZ][zZ]_?[wW][eE][iI][gG][hH][tT]|[fF][uU][zZ][zZ]_?[rR][oO][uU][gG][hH][nN][eE][sS][sS]|[sS][hH][eE][eE][nN]_?[wW][eE][iI][gG][hH][tT]|[sS][hH][eE][eE][nN]_?[rR][oO][uU][gG][hH][nN][eE][sS][sS]|[sS][hH][eE][eE][nN]_?[mM][aA][sS][kK]|[eE][mM][iI][sS][sS][iI][oO][nN]_?[wW][eE][iI][gG][hH][tT]|[eE][mM][iI][sS][sS][iI][oO][nN]_?[lL][uU][mM][iI][nN][aA][nN][cC][eE]|[tT][hH][iI][nN]_?[fF][iI][lL][mM]_?[wW][eE][iI][gG][hH][tT]|[tT][hH][iI][nN]_?[fF][iI][lL][mM]_?[tT][hH][iI][cC][kK][nN][eE][sS][sS]|[tT][hH][iI][nN]_?[fF][iI][lL][mM]_?[iI][oO][rR]|[tT][hH][iI][nN]_?[wW][aA][lL][lL][eE][dD]|[iI][oO][rR]|[sS][pP][eE][cC][uU][lL][aA][rR]_?[iI][oO][rR]|[cC][oO][aA][tT]_?[iI][oO][rR]|[iI][nN][dD][eE][xX]_?[oO][fF]_?[rR][eE][fF][rR][aA][cC][tT][iI][oO][nN])(?!_?[cC][oO][lL][oO][uU]?[rR])[_.-][^/\\\\]*"}
  # 4 a whole folder named by a token: textures/srgb/wood.png
  - !<Rule> {name: tokenized_Raw_folder, colorspace: Raw, regex: "(.*[/\\\\])?([rR][aA][wW]|[dD][aA][tT][aA]|[nN][oO][nN]_?[cC][oO][lL][oO][uU]?[rR]|[uU][tT][iI][lL][iI][tT][yY]_[rR][aA][wW])[/\\\\].*"}
  - !<Rule> {name: tokenized_ACES2065_1_folder, colorspace: ACES2065-1, regex: "(.*[/\\\\])?([aA][cC][eE][sS]2065[_-]1|[lL][iI][nN]_[aA][pP]0(_[sS][cC][eE][nN][eE])?|[aA][pP]0)[/\\\\].*"}
  - !<Rule> {name: tokenized_ACEScg_folder, colorspace: ACEScg, regex: "(.*[/\\\\])?([aA][cC][eE][sS][cC][gG]|[lL][iI][nN]_[aA][cC][eE][sS][cC][gG]|[lL][iI][nN]_[aA][pP]1(_[sS][cC][eE][nN][eE])?)[/\\\\].*"}
  - !<Rule> {name: tokenized_ACEScct_folder, colorspace: ACEScct, regex: "(.*[/\\\\])?([aA][cC][eE][sS][cC][cC][tT](_[aA][pP]1)?)[/\\\\].*"}
  - !<Rule> {name: tokenized_ACEScc_folder, colorspace: ACEScc, regex: "(.*[/\\\\])?([aA][cC][eE][sS][cC][cC](_[aA][pP]1)?)[/\\\\].*"}
  - !<Rule> {name: tokenized_LinRec709_folder, colorspace: Linear Rec.709 (sRGB), regex: "(.*[/\\\\])?([lL][iI][nN]([eE][aA][rR])?_?([rR][eE][cC]\\.?|[bB][tT])709(_[sS][rR][gG][bB]|_[sS][cC][eE][nN][eE])?|[lL][iI][nN]([eE][aA][rR])?_?[sS][rR][gG][bB])[/\\\\].*"}
  - !<Rule> {name: tokenized_LinRec2020_folder, colorspace: Linear Rec.2020, regex: "(.*[/\\\\])?([lL][iI][nN]([eE][aA][rR])?_?([rR][eE][cC]\\.?|[bB][tT])2020(_[sS][cC][eE][nN][eE])?)[/\\\\].*"}
  - !<Rule> {name: tokenized_LinP3D65_folder, colorspace: Linear P3-D65, regex: "(.*[/\\\\])?([lL][iI][nN]([eE][aA][rR])?_?([pP]3_?[dD]65|[dD][iI][sS][pP][lL][aA][yY]_?[pP]3)(_[sS][cC][eE][nN][eE])?)[/\\\\].*"}
  - !<Rule> {name: tokenized_LinAdobeRGB_folder, colorspace: Linear AdobeRGB, regex: "(.*[/\\\\])?([lL][iI][nN]([eE][aA][rR])?_?[aA][dD][oO][bB][eE]_?[rR][gG][bB](_[sS][cC][eE][nN][eE])?)[/\\\\].*"}
  - !<Rule> {name: tokenized_CIEXYZD65_folder, colorspace: CIE XYZ-D65 - Scene-referred, regex: "(.*[/\\\\])?(([lL][iI][nN]_)?[cC][iI][eE]_?[xX][yY][zZ]_?[dD]65(_[sS][cC][eE][nN][eE])?)[/\\\\].*"}
  - !<Rule> {name: tokenized_sRGB_P3D65_folder, colorspace: sRGB Encoded P3-D65, regex: "(.*[/\\\\])?([sS][rR][gG][bB]_([eE][nN][cC][oO][dD][eE][dD]_)?([pP]3_?[dD]65|[dD][iI][sS][pP][lL][aA][yY]_?[pP]3)(_[sS][cC][eE][nN][eE]|_[tT][xX])?)[/\\\\].*"}
  - !<Rule> {name: tokenized_sRGB_AP1_folder, colorspace: sRGB Encoded AP1, regex: "(.*[/\\\\])?([sS][rR][gG][bB]_([eE][nN][cC][oO][dD][eE][dD]_)?[aA][pP]1(_[sS][cC][eE][nN][eE]|_[tT][xX])?)[/\\\\].*"}
  - !<Rule> {name: tokenized_G22_AP1_folder, colorspace: Gamma 2.2 Encoded AP1, regex: "(.*[/\\\\])?([gG]22_([eE][nN][cC][oO][dD][eE][dD]_)?[aA][pP]1(_[sS][cC][eE][nN][eE]|_[tT][xX])?)[/\\\\].*"}
  - !<Rule> {name: tokenized_G18_Rec709_folder, colorspace: Gamma 1.8 Encoded Rec.709, regex: "(.*[/\\\\])?([gG]18_([eE][nN][cC][oO][dD][eE][dD]_)?[rR][eE][cC]\\.?709(_[sS][cC][eE][nN][eE]|_[tT][xX])?)[/\\\\].*"}
  - !<Rule> {name: tokenized_G22_Rec709_folder, colorspace: Gamma 2.2 Encoded Rec.709, regex: "(.*[/\\\\])?([gG]22_([eE][nN][cC][oO][dD][eE][dD]_)?[rR][eE][cC]\\.?709(_[sS][cC][eE][nN][eE]|_[tT][xX])?)[/\\\\].*"}
  - !<Rule> {name: tokenized_G24_Rec709_folder, colorspace: Gamma 2.4 Encoded Rec.709, regex: "(.*[/\\\\])?([gG]24_([eE][nN][cC][oO][dD][eE][dD]_)?[rR][eE][cC]\\.?709(_[sS][cC][eE][nN][eE]|_[tT][xX])?|([rR][eE][cC]|[bB][tT])\\.?1886(_[rR][eE][cC]\\.?709)?|[rR][eE][cC]709_[dD][iI][sS][pP][lL][aA][yY])[/\\\\].*"}
  - !<Rule> {name: tokenized_G22_AdobeRGB_folder, colorspace: Gamma 2.2 Encoded AdobeRGB, regex: "(.*[/\\\\])?(([gG]22_([eE][nN][cC][oO][dD][eE][dD]_)?)?[aA][dD][oO][bB][eE]_?[rR][gG][bB](_[sS][cC][eE][nN][eE])?)[/\\\\].*"}
  - !<Rule> {name: tokenized_sRGB_folder, colorspace: sRGB Encoded Rec.709 (sRGB), regex: "(.*[/\\\\])?([sS][rR][gG][bB](_[eE][nN][cC][oO][dD][eE][dD])?(_[rR][eE][cC]\\.?709)?(_[sS][rR][gG][bB]|_[sS][cC][eE][nN][eE]|_[tT][xX]|_[tT][eE][xX][tT][uU][rR][eE])?)[/\\\\].*"}
  # 5 mip containers keep the encoding of their source: wood.png.tex, hdri.exr.tx
  - !<Rule> {name: mip_from_byte, colorspace: sRGB Encoded Rec.709 (sRGB), regex: ".*\\.([pP][nN][gG]|[jJ][pP][gG]|[jJ][pP][eE][gG]|[tT][gG][aA]|[tT][iI][fF]|[tT][iI][fF][fF]|[bB][mM][pP]|[wW][eE][bB][pP]|[pP][sS][dD]|[gG][iI][fF])\\.([tT][xX]|[tT][eE][xX]|[rR][aA][tT])\\]?"}
  - !<Rule> {name: mip_from_hdr, colorspace: Linear Rec.709 (sRGB), regex: ".*\\.([hH][dD][rR]|[pP][fF][mM])\\.([tT][xX]|[tT][eE][xX]|[rR][aA][tT])\\]?"}
  - !<Rule> {name: mip_from_exr, colorspace: ACEScg, regex: ".*\\.([eE][xX][rR])\\.([tT][xX]|[tT][eE][xX]|[rR][aA][tT])\\]?"}
  # 6 untokenized defaults by type. Encoded files use scene-referred encodings, never a
  #   "- Display" space: those read back through the default view transform.
  - !<Rule> {name: byte_images, colorspace: sRGB Encoded Rec.709 (sRGB), regex: ".*\\.([pP][nN][gG]|[jJ][pP][gG]|[jJ][pP][eE][gG]|[tT][gG][aA]|[tT][iI][fF]|[tT][iI][fF][fF]|[bB][mM][pP]|[wW][eE][bB][pP]|[pP][sS][dD]|[gG][iI][fF])\\]?"}
  - !<Rule> {name: openexr, colorspace: ACEScg, regex: ".*\\.([eE][xX][rR])\\]?"}
  - !<Rule> {name: radiance_hdr, colorspace: Linear Rec.709 (sRGB), regex: ".*\\.([hH][dD][rR]|[pP][fF][mM])\\]?"}
  - !<Rule> {name: mip_containers, colorspace: ACEScg, regex: ".*\\.([tT][xX]|[tT][eE][xX]|[rR][aA][tT])\\]?"}
  - !<Rule> {name: movies, colorspace: Gamma 2.4 Encoded Rec.709, regex: ".*\\.([mM][pP]4|[mM][oO][vV]|[mM][xX][fF]|[mM]4[vV]|[aA][vV][iI]|[mM][kK][vV]|[wW][eE][bB][mM])\\]?"}
  - !<Rule> {name: Default, colorspace: ACEScg}

viewing_rules:
  - !<Rule> {name: Any Scene-linear or Log, encodings: [log, scene-linear]}
  - !<Rule> {name: Any Video, encodings: [sdr-video, hdr-video, edr-video, display-linear]}

shared_views:
  - !<View> {name: Sensor RAW, view_transform: Sensor RAW, display_colorspace: <USE_DISPLAY_NAME>, rule: Any Scene-linear or Log}
  - !<View> {name: False Color, view_transform: False Color, display_colorspace: <USE_DISPLAY_NAME>, rule: Any Scene-linear or Log}
  - !<View> {name: JPG Standard, view_transform: JPG Standard, display_colorspace: <USE_DISPLAY_NAME>, rule: Any Scene-linear or Log}
  - !<View> {name: JPG Neutral, view_transform: JPG Neutral, display_colorspace: <USE_DISPLAY_NAME>, rule: Any Scene-linear or Log}
  - !<View> {name: JPG Vivid, view_transform: JPG Vivid, display_colorspace: <USE_DISPLAY_NAME>, rule: Any Scene-linear or Log}
  - !<View> {name: JPG Clear, view_transform: JPG Clear, display_colorspace: <USE_DISPLAY_NAME>, rule: Any Scene-linear or Log}
  - !<View> {name: JPG Deep, view_transform: JPG Deep, display_colorspace: <USE_DISPLAY_NAME>, rule: Any Scene-linear or Log}
  - !<View> {name: JPG Light, view_transform: JPG Light, display_colorspace: <USE_DISPLAY_NAME>, rule: Any Scene-linear or Log}
  - !<View> {name: JPG Portrait, view_transform: JPG Portrait, display_colorspace: <USE_DISPLAY_NAME>, rule: Any Scene-linear or Log}
  - !<View> {name: JPG Landscape, view_transform: JPG Landscape, display_colorspace: <USE_DISPLAY_NAME>, rule: Any Scene-linear or Log}
  - !<View> {name: JPG Monochrome, view_transform: JPG Monochrome, display_colorspace: <USE_DISPLAY_NAME>, rule: Any Scene-linear or Log}
  - !<View> {name: JPG Sepia, view_transform: JPG Sepia, display_colorspace: <USE_DISPLAY_NAME>, rule: Any Scene-linear or Log}
  - !<View> {name: ACES 2.0 - SDR 100 nits (Rec.709), view_transform: ACES 2.0 - SDR 100 nits (Rec.709), display_colorspace: <USE_DISPLAY_NAME>, rule: Any Scene-linear or Log}
  - !<View> {name: ACES 2.0 - SDR 100 nits (P3 D65), view_transform: ACES 2.0 - SDR 100 nits (P3 D65), display_colorspace: <USE_DISPLAY_NAME>, rule: Any Scene-linear or Log}
  - !<View> {name: ACES 2.0 - HDR 1000 nits (P3 D65), view_transform: ACES 2.0 - HDR 1000 nits (P3 D65), display_colorspace: <USE_DISPLAY_NAME>, rule: Any Scene-linear or Log}
  - !<View> {name: ACES 2.0 - HDR 500 nits (P3 D65), view_transform: ACES 2.0 - HDR 500 nits (P3 D65), display_colorspace: <USE_DISPLAY_NAME>, rule: Any Scene-linear or Log}
  - !<View> {name: ACES 2.0 - HDR 2000 nits (P3 D65), view_transform: ACES 2.0 - HDR 2000 nits (P3 D65), display_colorspace: <USE_DISPLAY_NAME>, rule: Any Scene-linear or Log}
  - !<View> {name: ACES 2.0 - HDR 4000 nits (P3 D65), view_transform: ACES 2.0 - HDR 4000 nits (P3 D65), display_colorspace: <USE_DISPLAY_NAME>, rule: Any Scene-linear or Log}
  - !<View> {name: ACES 2.0 - HDR 500 nits (Rec.2020), view_transform: ACES 2.0 - HDR 500 nits (Rec.2020), display_colorspace: <USE_DISPLAY_NAME>, rule: Any Scene-linear or Log}
  - !<View> {name: ACES 2.0 - HDR 1000 nits (Rec.2020), view_transform: ACES 2.0 - HDR 1000 nits (Rec.2020), display_colorspace: <USE_DISPLAY_NAME>, rule: Any Scene-linear or Log}
  - !<View> {name: ACES 2.0 - HDR 2000 nits (Rec.2020), view_transform: ACES 2.0 - HDR 2000 nits (Rec.2020), display_colorspace: <USE_DISPLAY_NAME>, rule: Any Scene-linear or Log}
  - !<View> {name: ACES 2.0 - HDR 4000 nits (Rec.2020), view_transform: ACES 2.0 - HDR 4000 nits (Rec.2020), display_colorspace: <USE_DISPLAY_NAME>, rule: Any Scene-linear or Log}
  - !<View> {name: ACES 2.0 - HDR 108 nits (P3 D65), view_transform: ACES 2.0 - HDR 108 nits (P3 D65), display_colorspace: <USE_DISPLAY_NAME>, rule: Any Scene-linear or Log}
  - !<View> {name: Un-tone-mapped, view_transform: Un-tone-mapped, display_colorspace: <USE_DISPLAY_NAME>, rule: Any Scene-linear or Log}
  - !<View> {name: Video (colorimetric), view_transform: Video (colorimetric), display_colorspace: <USE_DISPLAY_NAME>, rule: Any Video}
  - !<View> {name: Raw, colorspace: Raw}

displays:
