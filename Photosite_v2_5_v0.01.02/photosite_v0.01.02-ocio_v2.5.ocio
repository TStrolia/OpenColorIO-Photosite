        urn:ampas:aces:transformId:v2.0:InvOutput.Academy.P3-D65_108nit_in_P3-D65_ST2084.a2.v1
        urn:ampas:aces:transformId:v2.0:Output.Academy.P3-D65_108nit_in_P3-D65_ST2084.a2.v1
    from_scene_reference: !<BuiltinTransform> {style: ACES-OUTPUT - ACES2065-1_to_CIE-XYZ-D65 - HDR-108nit-P3-D65_2.0}

  - !<ViewTransform>
    name: Sensor RAW
    family: Camera
    description: |
      Sensor RAW: true scene-linear sensor data. Scene -> white-balanced camera RGB (the camera's fitted colour matrix),
      each channel clipped at 0 and at its sensor saturation for a D65 white balance (R 6.233, G 2.332, B 3.143 scene-linear),
      then back to XYZ through the same matrix. No tone curve or exposure gain: scene 0.18 shows as display-linear 0.18.
    from_scene_reference: !<GroupTransform>
      name: Sensor RAW
      children:
          - !<MatrixTransform> {matrix: [0.187860340707, -0.0169622841175, -0.0104690771256, 0, -0.0313314676801, 0.382088598708, 0.0780546690242, 0, -0.00891639146151, 0.059149667319, 0.267981267341, 0, 0, 0, 0, 1]}
          - !<RangeTransform> {min_in_value: 0, max_in_value: 1, min_out_value: 0, max_out_value: 1}
          - !<MatrixTransform> {matrix: [5.03435752528, 0.179903043813, 0.206321616335, 0, 2.11291652983, 2.12476840542, -0.785943988237, 0, 0.0978041298907, -0.666605854812, 4.27138111581, 0, 0, 0, 0, 1]}

  - !<ViewTransform>
    name: False Color
    family: Camera
    description: |
      False Color: exposure bands on the sensor's own scale. Signal: the brightest sensor channel relative to its own
      saturation, in stops (a neutral reads its exposure). 100 % = the sensor's white clip (+3.70 EV over 0.18), 50 % =
      middle grey 0.18, 0 % = the sensor's noise floor (signal = noise, -10.30 EV). Red: at or past the white clip in
      any channel. Orange: the last 0.52 stops before it. Purple: at or below the noise floor. Plateaus of solid colour
      with smooth S-curve transitions between them.
